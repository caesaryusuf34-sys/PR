# Copy to ".env" (same folder as app.py) and fill in what you have. Every line is optional,
# but CONTACT_EMAIL is strongly recommended. Never commit your real .env file.

# A real e-mail address. Required by Unpaywall, used for Crossref/OpenAlex "polite pool" access.
CONTACT_EMAIL=

# CORE (repository full texts) - free key: https://core.ac.uk/services/api
CORE_API_KEY=

# Higher rate limits (free keys): Semantic Scholar https://www.semanticscholar.org/product/api ; OpenAlex https://openalex.org
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# Open-web search for repository copies / PDFs - configure ONE of these:
# Brave Search API: https://api.search.brave.com
BRAVE_API_KEY=
# Google Programmable Search Engine (Custom Search JSON API): key + search-engine id (cx)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- optional tuning ------------------------------------------------------------------
# DOWNLOAD_DIR=Downloaded_Papers
# DATABASE_PATH=research_history.sqlite3
# AGENT_MAX_REQUESTS=300        # total HTTP requests per search
# AGENT_MAX_PAGES=12            # web pages the crawler may open
# AGENT_MAX_DEPTH=2             # link depth from a starting page
# AGENT_MAX_CANDIDATES=16       # full-text locations examined
# AGENT_MAX_DOWNLOADS=8         # PDFs downloaded while looking for the right one
# AGENT_TIME_LIMIT=300          # seconds
# MAX_PDF_MB=60
# AUTO_DOWNLOAD=false           # default: only return the verified PDF link; true = also save the PDF locally
# ALLOW_PREPRINTS=true
# ACCEPT_PARTIAL_VERIFICATION=true
# AUTO_PICK_TOPIC=false         # true = research-topic queries download the top-ranked paper without asking
# EXTRA_BLOCKED_DOMAINS=example-pirate-site.org
